/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Static assets: revalidate hourly, then serve stale for a day while the
# origin revalidates in the background. Filenames are not hashed, so this is
# a freshness/repeat-view trade — a deploy reaches returning visitors within
# the hour instead of after a multi-day immutable TTL.
/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/img/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# AdSense crawler: plain ads.txt at apex/www (no HTML soft-404)
/ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: all

# Market news snapshot — short cache so auto-refresh stays current
/data/market-news.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
